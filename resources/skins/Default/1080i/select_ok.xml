<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">10</defaultcontrol>
	<controls>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture>black.png</texture>
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="85" time="200" tween="sine" easing="in" />
			</animation>
		</control>
		<control type="group">
			<animation type="WindowOpen" reversible="false">
				<effect type="zoom" start="90" end="100" time="250" center="auto" tween="quadratic" easing="out" />
				<effect type="fade" start="0" end="100" time="250" />
			</animation>
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>780</width>
			<height>480</height>
			<control type="group">
				<!-- Dialog background -->
				<control type="image">
					<texture colordiffuse="E0181820">rounded_button.png</texture>
				</control>
				<!-- Header accent -->
				<control type="image">
					<height>80</height>
					<texture colordiffuse="20FFFFFF">rounded_button.png</texture>
				</control>
				<!-- POV Icon -->
				<control type="image">
					<left>15</left>
					<top>15</top>
					<width>50</width>
					<height>50</height>
					<align>left</align>
					<aligny>top</aligny>
					<aspectratio aligny="top">keep</aspectratio>
					<texture>$INFO[Window.Property(tikiskins.pov.icon)]</texture>
				</control>
				<!-- Heading -->
				<control type="label">
					<height>80</height>
					<font>font12</font>
					<textcolor>EEFFFFFF</textcolor>
					<align>center</align>
					<aligny>center</aligny>
					<label>[UPPERCASE][B]$INFO[Window.Property(tikiskins.dialog.heading)][/B][/UPPERCASE]</label>
				</control>
			</control>
			<control type="group">
				<!-- Body text -->
				<control type="textbox">
					<left>40</left>
					<top>110</top>
					<width>700</width>
					<height>230</height>
					<font>font12</font>
					<textcolor>CCFFFFFF</textcolor>
					<align>center</align>
					<aligny>top</aligny>
					<label>$INFO[Window.Property(tikiskins.dialog.text)]</label>
				</control>
				<!-- Single button (OK only) -->
				<control type="group">
					<visible>String.IsEmpty(Window.Property(tikiskins.dialog.cancel_label))</visible>
					<control type="button" id="10">
						<description>OK</description>
						<top>370</top>
						<left>220</left>
						<width>340</width>
						<height>60</height>
						<onleft>11</onleft>
						<onright>11</onright>
						<label>[B]$INFO[Window.Property(tikiskins.dialog.ok_label)][/B]</label>
						<font>font12</font>
						<textcolor>BBFFFFFF</textcolor>
						<focusedcolor>FF1A1A2E</focusedcolor>
						<texturefocus colordiffuse="EEFFFFFF">rounded_button.png</texturefocus>
						<texturenofocus colordiffuse="30FFFFFF">rounded_button.png</texturenofocus>
						<align>center</align>
					</control>
				</control>
				<!-- Dual buttons (OK + Cancel) -->
				<control type="group">
					<visible>!String.IsEmpty(Window.Property(tikiskins.dialog.cancel_label))</visible>
					<control type="button" id="10">
						<description>OK</description>
						<top>370</top>
						<left>35</left>
						<width>340</width>
						<height>60</height>
						<onleft>11</onleft>
						<onright>11</onright>
						<label>[B]$INFO[Window.Property(tikiskins.dialog.ok_label)][/B]</label>
						<font>font12</font>
						<textcolor>BBFFFFFF</textcolor>
						<focusedcolor>FF1A1A2E</focusedcolor>
						<texturefocus colordiffuse="EEFFFFFF">rounded_button.png</texturefocus>
						<texturenofocus colordiffuse="30FFFFFF">rounded_button.png</texturenofocus>
						<align>center</align>
					</control>
					<control type="button" id="11">
						<description>Cancel</description>
						<top>370</top>
						<left>405</left>
						<width>340</width>
						<height>60</height>
						<onleft>10</onleft>
						<onright>10</onright>
						<label>[B]$INFO[Window.Property(tikiskins.dialog.cancel_label)][/B]</label>
						<font>font12</font>
						<textcolor>BBFFFFFF</textcolor>
						<focusedcolor>FF1A1A2E</focusedcolor>
						<texturefocus colordiffuse="EEFFFFFF">rounded_button.png</texturefocus>
						<texturenofocus colordiffuse="30FFFFFF">rounded_button.png</texturenofocus>
						<align>center</align>
					</control>
				</control>
			</control>
		</control>
	</controls>
</window>
