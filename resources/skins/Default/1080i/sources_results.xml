<?xml version="1.0" encoding="UTF-8"?>
<window>
	<controls>
		<!-- ==================== BACKGROUND ==================== -->
		<control type="group">
			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1920</width>
				<height>1080</height>
				<texture>black.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1920</width>
				<height>1080</height>
				<texture>$INFO[Window.Property(tikiskins.fanart)]</texture>
				<animation effect="fade" start="0" end="20" time="0" tween="sine">WindowOpen</animation>
			</control>
			<!-- Dark gradient overlay from left -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1200</width>
				<height>1080</height>
				<texture>gradient_dark_left.png</texture>
			</control>
			<control type="image">
				<texture colordiffuse="85000000">white.png</texture>
			</control>
		</control>

		<!-- ==================== TOP BAR ==================== -->
		<control type="group">
			<animation effect="fade" start="0" end="100" delay="200" time="400">WindowOpen</animation>
			<!-- POV Logo -->
			<control type="image">
				<left>35</left>
				<top>20</top>
				<width>50</width>
				<height>50</height>
				<aspectratio aligny="top">keep</aspectratio>
				<texture>$INFO[Window.Property(tikiskins.pov.icon)]</texture>
			</control>
			<!-- Results info -->
			<control type="label">
				<left>95</left>
				<top>25</top>
				<width max="500">auto</width>
				<height>40</height>
				<font>font10</font>
				<textcolor>AAFFFFFF</textcolor>
				<align>left</align>
				<aligny>center</aligny>
				<label>[B]$INFO[Window.Property(tikiskins.total_results)][/B] Results  |  [B]$INFO[Window.Property(tikiskins.scrape_time)][/B]s $INFO[Window.Property(tikiskins.filters_ignored)]</label>
			</control>
		</control>

		<!-- ==================== CLEARLOGO / TITLE ==================== -->
		<control type="group">
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="400" tween="sine" delay="200" />
				<effect type="slide" start="0,-30" end="0" time="350" delay="200" tween="quadratic" easing="out" />
			</animation>
			<!-- Clearlogo -->
			<control type="image">
				<top>80</top>
				<left>60</left>
				<width max="400">auto</width>
				<height>140</height>
				<aspectratio aligny="bottom">keep</aspectratio>
				<texture background="true">$INFO[Window.Property(tikiskins.clearlogo)]</texture>
				<visible>!String.IsEmpty(Window.Property(tikiskins.clearlogo))</visible>
			</control>
			<!-- Title fallback -->
			<control type="label">
				<top>100</top>
				<left>60</left>
				<width max="500">auto</width>
				<height>120</height>
				<font>font50</font>
				<textcolor>FFFFFFFF</textcolor>
				<align>left</align>
				<aligny>bottom</aligny>
				<wrapmultiline>true</wrapmultiline>
				<label>[B]$INFO[Window.Property(tikiskins.title)][/B]</label>
				<visible>String.IsEmpty(Window.Property(tikiskins.clearlogo))</visible>
			</control>
		</control>

		<!-- ==================== LEFT SIDE - POSTER & PLOT ==================== -->
		<control type="group">
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="500" tween="sine" delay="300" />
				<effect type="slide" start="-40,0" end="0" time="400" delay="300" tween="quadratic" easing="out" />
			</animation>
			<left>60</left>
			<top>240</top>
