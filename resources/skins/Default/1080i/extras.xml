<?xml version="1.0" encoding="UTF-8"?>
<window>
	<controls>
		<!-- ==================== BACKGROUND ==================== -->
		<control type="group">
			<animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
			<width>1920</width>
			<height>1080</height>
			<!-- Black base -->
			<control type="image">
				<texture>black.png</texture>
			</control>
			<!-- Fanart right side with gradient fade -->
			<control type="image">
				<left>500</left>
				<top>0</top>
				<width>1420</width>
				<height>1080</height>
				<aspectratio>scale</aspectratio>
				<texture>$INFO[Window.Property(tikiskins.extras.fanart)]</texture>
				<animation type="WindowOpen" reversible="false">
					<effect type="fade" start="0" end="60" time="800" tween="sine" />
				</animation>
			</control>
			<!-- Dark gradient overlay from left -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1200</width>
				<height>1080</height>
				<texture>gradient_dark_left.png</texture>
			</control>
			<!-- Dark overlay bottom -->
			<control type="image">
				<left>0</left>
				<top>700</top>
				<width>1920</width>
				<height>380</height>
				<texture>gradient_dark_bottom.png</texture>
			</control>
			<!-- Subtle dark overlay on entire screen -->
			<control type="image">
				<texture colordiffuse="90000000">white.png</texture>
			</control>
		</control>

		<!-- ==================== HIDDEN POSTER CONTROLS (compatibility) ==================== -->
		<control type="image" id="200">
			<left>-9999</left>
			<top>-9999</top>
			<width>1</width>
			<height>1</height>
			<visible>false</visible>
		</control>
		<control type="image" id="201">
			<left>-9999</left>
			<top>-9999</top>
			<width>1</width>
			<height>1</height>
			<visible>false</visible>
		</control>

		<!-- ==================== TOP BAR ==================== -->
		<control type="group">
			<animation effect="fade" start="0" end="100" delay="200" time="400">WindowOpen</animation>
			<!-- POV Logo -->
			<control type="image">
				<left>60</left>
				<top>30</top>
				<width>50</width>
				<height>50</height>
				<aspectratio aligny="top">keep</aspectratio>
				<texture>$INFO[Window.Property(tikiskins.pov.icon)]</texture>
			</control>
			<!-- Tips -->
			<control type="label">
				<left>120</left>
				<top>38</top>
				<width max="600">auto</width>
				<height>30</height>
				<font>font10</font>
				<textcolor>99FFFFFF</textcolor>
				<align>left</align>
				<aligny>center</aligny>
				<label>[I]$INFO[Window.Property(tikiskins.extras.tip_text)][/I]</label>
				<visible>!String.IsEmpty(Window.Property(tikiskins.extras.tip_text))</visible>
			</control>
		</control>

		<!-- ==================== LEFT PANEL - CONTENT INFO ==================== -->
		<control type="group">
			<left>60</left>
			<top>0</top>
			<width>960</width>
			<height>1080</height>

			<!-- Clearlogo / Title -->
			<control type="group">
				<animation type="WindowOpen" reversible="false">
					<effect type="fade" start="0" end="100" time="600" tween="sine" delay="200" />
					<effect type="slide" start="0,-40" end="0" time="500" delay="200" tween="quadratic" easing="out" />
				</animation>
				<!-- Clearlogo -->
				<control type="image">
					<top>80</top>
					<left>0</left>
					<width max="500">auto</width>
					<height>180</height>
					<aspectratio aligny="bottom">keep</aspectratio>
					<texture background="true">$INFO[Window.Property(tikiskins.extras.clearlogo)]</texture>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.clearlogo))</visible>
				</control>
				<!-- Title (fallback when no clearlogo) -->
				<control type="label">
					<top>120</top>
					<left>0</left>
					<width max="900">auto</width>
					<height>140</height>
					<font>font60</font>
					<textcolor>FFFFFFFF</textcolor>
					<align>left</align>
					<aligny>bottom</aligny>
					<wrapmultiline>true</wrapmultiline>
					<label>[B]$INFO[Window.Property(tikiskins.extras.title)][/B]</label>
					<visible>String.IsEmpty(Window.Property(tikiskins.extras.clearlogo))</visible>
				</control>
			</control>

			<!-- Tagline -->
			<control type="label">
				<animation type="WindowOpen" reversible="false">
					<effect type="fade" start="0" end="100" time="500" delay="350" tween="sine" />
				</animation>
				<top>270</top>
				<left>0</left>
				<width max="860">auto</width>
				<height>25</height>
				<font>font13</font>
				<textcolor>99FFFFFF</textcolor>
				<align>left</align>
				<label>[I]$INFO[Window.Property(tikiskins.extras.tagline)][/I]</label>
				<visible>!String.IsEmpty(Window.Property(tikiskins.extras.tagline))</visible>
			</control>

			<!-- Year / Duration / Seasons / Network info line -->
			<control type="grouplist">
				<animation type="WindowOpen" reversible="false">
					<effect type="fade" start="0" end="100" time="500" delay="350" tween="sine" />
				</animation>
				<top>302</top>
				<left>0</left>
				<width max="900">auto</width>
				<height>25</height>
				<orientation>horizontal</orientation>
				<itemgap>0</itemgap>
				<control type="label">
					<width min="20" max="80">auto</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>CCFFFFFF</textcolor>
					<label>$INFO[Window.Property(tikiskins.extras.year)]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.year))</visible>
				</control>
				<control type="label">
					<width>30</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>66FFFFFF</textcolor>
					<align>center</align>
					<label>|</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.year))</visible>
				</control>
				<control type="label">
					<width min="20" max="300">auto</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>CCFFFFFF</textcolor>
					<label>$INFO[Window.Property(tikiskins.extras.duration)]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.duration))</visible>
				</control>
				<control type="label">
					<width>30</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>66FFFFFF</textcolor>
					<align>center</align>
					<label>|</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.duration))</visible>
				</control>
				<control type="label">
					<width min="20" max="250">auto</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>CCFFFFFF</textcolor>
					<label>$INFO[Window.Property(tikiskins.extras.mpaa)]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.mpaa))</visible>
				</control>
				<control type="label">
					<width>30</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>66FFFFFF</textcolor>
					<align>center</align>
					<label>|</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.mpaa)) + !String.IsEmpty(Window.Property(tikiskins.extras.network))</visible>
				</control>
				<control type="label">
					<width min="20" max="300">auto</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>CCFFFFFF</textcolor>
					<label>$INFO[Window.Property(tikiskins.extras.network)]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.network))</visible>
				</control>
			</control>

			<!-- TV Show episode info -->
			<control type="grouplist">
				<animation type="WindowOpen" reversible="false">
					<effect type="fade" start="0" end="100" time="500" delay="350" tween="sine" />
				</animation>
				<top>330</top>
				<left>0</left>
				<width max="900">auto</width>
				<height>25</height>
				<orientation>horizontal</orientation>
				<itemgap>0</itemgap>
				<visible>String.IsEqual(Window.Property(tikiskins.extras.media_type),tvshow)</visible>
				<control type="label">
					<width min="20" max="400">auto</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>AAFFFFFF</textcolor>
					<label>$INFO[Window.Property(tikiskins.extras.next_episode)]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.next_episode))</visible>
				</control>
				<control type="label">
					<width>30</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>66FFFFFF</textcolor>
					<align>center</align>
					<label>|</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.next_episode)) + !String.IsEmpty(Window.Property(tikiskins.extras.last_aired_episode))</visible>
				</control>
				<control type="label">
					<width min="20" max="400">auto</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>AAFFFFFF</textcolor>
					<label>$INFO[Window.Property(tikiskins.extras.last_aired_episode)]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.last_aired_episode))</visible>
				</control>
			</control>

			<!-- Movie progress info -->
			<control type="grouplist">
				<animation type="WindowOpen" reversible="false">
					<effect type="fade" start="0" end="100" time="500" delay="350" tween="sine" />
				</animation>
				<top>330</top>
				<left>0</left>
				<width max="900">auto</width>
				<height>25</height>
				<orientation>horizontal</orientation>
				<itemgap>0</itemgap>
				<visible>String.IsEqual(Window.Property(tikiskins.extras.media_type),movie)</visible>
				<control type="label">
					<width min="20" max="400">auto</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>AAFFFFFF</textcolor>
					<label>$INFO[Window.Property(tikiskins.extras.progress)]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.progress))</visible>
				</control>
				<control type="label">
					<width>30</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>66FFFFFF</textcolor>
					<align>center</align>
					<label>|</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.progress)) + !String.IsEmpty(Window.Property(tikiskins.extras.finish_watching))</visible>
				</control>
				<control type="label">
					<width min="20" max="400">auto</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>AAFFFFFF</textcolor>
					<label>$INFO[Window.Property(tikiskins.extras.finish_watching)]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.finish_watching))</visible>
				</control>
				<control type="label">
					<width>30</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>66FFFFFF</textcolor>
					<align>center</align>
					<label>|</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.stingers))</visible>
				</control>
				<control type="label">
					<width min="20" max="400">auto</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>AAFFFFFF</textcolor>
					<label>[B]$INFO[Window.Property(tikiskins.extras.stingers)][/B]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.stingers))</visible>
				</control>
			</control>

			<!-- ===== RATING BADGES ROW ===== -->
			<control type="grouplist">
				<animation type="WindowOpen" reversible="false">
					<effect type="fade" start="0" end="100" time="500" delay="400" tween="sine" />
				</animation>
				<top>365</top>
				<left>0</left>
				<width max="900">auto</width>
				<height>40</height>
				<itemgap>4</itemgap>
				<orientation>horizontal</orientation>
				<!-- IMDb -->
				<control type="group">
					<width>100</width>
					<height>36</height>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.rating.imdb))</visible>
					<control type="image">
						<width>100</width>
						<height>36</height>
						<texture colordiffuse="40FFFFFF">rounded_pill.png</texture>
					</control>
					<control type="image">
						<left>6</left>
						<top>6</top>
						<width>24</width>
						<height>24</height>
						<aspectratio>keep</aspectratio>
						<texture>imdb_small.png</texture>
					</control>
					<control type="label">
						<left>34</left>
						<width>60</width>
						<height>36</height>
						<font>font10</font>
						<textcolor>FFFFFFFF</textcolor>
						<align>left</align>
						<aligny>center</aligny>
						<label>[B]$INFO[Window.Property(tikiskins.extras.rating.imdb)][/B]</label>
					</control>
				</control>
				<!-- Metacritic -->
				<control type="group">
					<width>80</width>
					<height>36</height>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.rating.metacritic))</visible>
					<control type="image">
						<width>80</width>
						<height>36</height>
						<texture colordiffuse="40FFFFFF">rounded_pill.png</texture>
					</control>
					<control type="image">
						<left>6</left>
						<top>4</top>
						<width>24</width>
						<height>28</height>
						<aspectratio>keep</aspectratio>
						<texture>metacritic.png</texture>
					</control>
					<control type="label">
						<left>34</left>
						<width>40</width>
						<height>36</height>
						<font>font10</font>
						<textcolor>FFFFFFFF</textcolor>
						<align>left</align>
						<aligny>center</aligny>
						<label>[B]$INFO[Window.Property(tikiskins.extras.rating.metacritic)][/B]</label>
					</control>
				</control>
				<!-- Rotten Tomatoes -->
				<control type="group">
					<width>80</width>
					<height>36</height>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.rating.tomatoes))</visible>
					<control type="image">
						<width>80</width>
						<height>36</height>
						<texture colordiffuse="40FFFFFF">rounded_pill.png</texture>
					</control>
					<control type="image">
						<left>6</left>
						<top>4</top>
						<width>24</width>
						<height>28</height>
						<aspectratio>keep</aspectratio>
						<texture>tomatoes.png</texture>
					</control>
					<control type="label">
						<left>34</left>
						<width>40</width>
						<height>36</height>
						<font>font10</font>
						<textcolor>FFFFFFFF</textcolor>
						<align>left</align>
						<aligny>center</aligny>
						<label>[B]$INFO[Window.Property(tikiskins.extras.rating.tomatoes)][/B]</label>
					</control>
				</control>
				<!-- TMDb -->
				<control type="group">
					<width>90</width>
					<height>36</height>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.rating.tmdb))</visible>
					<control type="image">
						<width>90</width>
						<height>36</height>
						<texture colordiffuse="40FFFFFF">rounded_pill.png</texture>
					</control>
					<control type="image">
						<left>6</left>
						<top>4</top>
						<width>24</width>
						<height>28</height>
						<aspectratio>keep</aspectratio>
						<texture>tmdb_small.png</texture>
					</control>
					<control type="label">
						<left>34</left>
						<width>50</width>
						<height>36</height>
						<font>font10</font>
						<textcolor>FFFFFFFF</textcolor>
						<align>left</align>
						<aligny>center</aligny>
						<label>[B]$INFO[Window.Property(tikiskins.extras.rating.tmdb)][/B]</label>
					</control>
				</control>
				<!-- Trakt -->
				<control type="group">
					<width>90</width>
					<height>36</height>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.rating.trakt))</visible>
					<control type="image">
						<width>90</width>
						<height>36</height>
						<texture colordiffuse="40FFFFFF">rounded_pill.png</texture>
					</control>
					<control type="image">
						<left>6</left>
						<top>4</top>
						<width>24</width>
						<height>28</height>
						<aspectratio>keep</aspectratio>
						<texture>trakt.png</texture>
					</control>
					<control type="label">
						<left>34</left>
						<width>50</width>
						<height>36</height>
						<font>font10</font>
						<textcolor>FFFFFFFF</textcolor>
						<align>left</align>
						<aligny>center</aligny>
						<label>[B]$INFO[Window.Property(tikiskins.extras.rating.trakt)][/B]</label>
					</control>
				</control>
				<!-- MDBList -->
				<control type="group">
					<width>90</width>
					<height>36</height>
					<visible>!String.IsEmpty(Window.Property(tikiskins.extras.rating.mdblist))</visible>
					<control type="image">
						<width>90</width>
						<height>36</height>
						<texture colordiffuse="40FFFFFF">rounded_pill.png</texture>
					</control>
					<control type="image">
						<left>6</left>
						<top>4</top>
						<width>24</width>
						<height>28</height>
						<aspectratio>keep</aspectratio>
						<texture>mdblist.png</texture>
					</control>
					<control type="label">
						<left>34</left>
						<width>50</width>
						<height>36</height>
						<font>font10</font>
						<textcolor>FFFFFFFF</textcolor>
						<align>left</align>
						<aligny>center</aligny>
						<label>[B]$INFO[Window.Property(tikiskins.extras.rating.mdblist)][/B]</label>
					</control>
				</control>
			</control>

			<!-- ===== GENRE PILLS ===== -->
			<control type="panel" id="2070">
				<animation type="WindowOpen" reversible="false">
					<effect type="fade" start="0" end="100" time="500" delay="450" tween="sine" />
				</animation>
				<top>412</top>
				<left>0</left>
				<width>900</width>
				<height>34</height>
				<orientation>horizontal</orientation>
				<scrolltime>200</scrolltime>
				<viewtype label="">list</viewtype>
				<itemlayout height="34" width="120">
					<control type="image">
						<left>0</left>
						<top>2</top>
						<width>110</width>
						<height>28</height>
						<texture colordiffuse="50FFFFFF">rounded_pill.png</texture>
					</control>
					<control type="label">
						<left>0</left>
						<top>2</top>
						<width>110</width>
						<height>28</height>
						<font>font10</font>
						<textcolor>CCFFFFFF</textcolor>
						<align>center</align>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Property(tikiskins.extras.genre_name)]</label>
					</control>
				</itemlayout>
				<focusedlayout height="34" width="120">
					<control type="image">
						<left>0</left>
						<top>2</top>
						<width>110</width>
						<height>28</height>
						<texture colordiffuse="80FFFFFF">rounded_pill.png</texture>
					</control>
					<control type="label">
						<left>0</left>
						<top>2</top>
						<width>110</width>
						<height>28</height>
						<font>font10</font>
						<textcolor>FFFFFFFF</textcolor>
						<align>center</align>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Property(tikiskins.extras.genre_name)]</label>
					</control>
				</focusedlayout>
			</control>

			<!-- ===== SUMMARY SECTION ===== -->
			<control type="group">
				<animation type="WindowOpen" reversible="false">
					<effect type="fade" start="0" end="100" time="500" delay="500" tween="sine" />
				</animation>
				<top>458</top>
				<left>0</left>
				<control type="label">
					<width max="200">auto</width>
					<height>22</height>
					<font>font12</font>
					<textcolor>88FFFFFF</textcolor>
					<align>left</align>
					<label>[UPPERCASE][B]Summary[/B][/UPPERCASE]</label>
				</control>
				<!-- Plot -->
				<control type="textbox">
					<top>30</top>
					<width>880</width>
					<height>130</height>
					<font>font12</font>
					<textcolor>BBFFFFFF</textcolor>
					<align>left</align>
					<label>$INFO[Window.Property(tikiskins.extras.plot)]</label>
					<autoscroll delay="6000" time="2000" repeat="10000">true</autoscroll>
				</control>
			</control>

			<!-- ===== CAST & CREW SECTION ===== -->
			<control type="group">
				<animation type="WindowOpen" reversible="false">
					<effect type="fade" start="0" end="100" time="500" delay="600" tween="sine" />
				</animation>
				<top>630</top>
				<left>0</left>
				<control type="label">
					<width max="200">auto</width>
					<height>22</height>
					<font>font12</font>
					<textcolor>88FFFFFF</textcolor>
					<align>left</align>
					<label>[UPPERCASE][B]Cast &amp; Crew[/B][/UPPERCASE]</label>
					<visible>Integer.IsGreater(Container(2050).NumItems,0)</visible>
				</control>
				<!-- Cast horizontal panel with circular photos -->
				<control type="panel" id="2050">
					<top>30</top>
					<width>900</width>
					<height>180</height>
					<onup>2049</onup>
					<ondown>2049</ondown>
					<onright>2051</onright>
					<viewtype label="">list</viewtype>
					<scrolltime>200</scrolltime>
					<orientation>horizontal</orientation>
					<itemlayout height="175" width="110">
						<control type="image">
							<left>10</left>
							<top>5</top>
