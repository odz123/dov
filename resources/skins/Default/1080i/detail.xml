<?xml version="1.0" encoding="UTF-8"?>
<window>
	<controls>
		<!-- Dark Background -->
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="FF0A0A0F">white.png</texture>
		</control>
		<!-- Fanart backdrop (subtle, right-biased) -->
		<control type="group">
			<animation effect="fade" start="0" end="100" time="800">WindowOpen</animation>
			<control type="image">
				<width>1920</width>
				<height>1080</height>
				<aspectratio>scale</aspectratio>
				<texture background="true" diffuse="gradient-diffuse-horizontal.png">$INFO[Window.Property(tikiskins.detail.fanart)]</texture>
				<animation effect="fade" start="0" end="15" time="0">WindowOpen</animation>
			</control>
			<!-- Dark overlay on left panel -->
			<control type="image">
				<width>960</width>
				<height>1080</height>
				<texture colordiffuse="D0000000">white.png</texture>
			</control>
			<!-- Dark overlay on right panel -->
			<control type="image">
				<left>960</left>
				<width>960</width>
				<height>1080</height>
				<texture colordiffuse="E8101018">white.png</texture>
			</control>
		</control>
		<!-- Left Panel: Info -->
		<control type="group">
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="500" tween="sine" delay="100" />
				<effect type="slide" start="-30,0" end="0" time="400" delay="100" tween="quadratic" easing="out" />
			</animation>
			<left>60</left>
			<top>40</top>
			<!-- Back Arrow -->
			<control type="button" id="5000">
				<width>40</width>
				<height>40</height>
				<font>font14</font>
				<textcolor>FFFFFFFF</textcolor>
				<focusedcolor>FF00BFA5</focusedcolor>
				<label>[B]&lt;[/B]</label>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus colordiffuse="FF333340">white.png</texturefocus>
				<texturenofocus colordiffuse="00000000">white.png</texturenofocus>
				<ondown>5001</ondown>
				<onright>5020</onright>
			</control>
			<!-- Title -->
			<control type="label">
				<top>60</top>
				<width>840</width>
				<height>120</height>
				<font>font60</font>
				<textcolor>FFFFFFFF</textcolor>
				<align>left</align>
				<aligny>bottom</aligny>
				<wrapmultiline>true</wrapmultiline>
				<label>[B]$INFO[Window.Property(tikiskins.detail.title)][/B]</label>
				<visible>String.IsEmpty(Window.Property(tikiskins.detail.clearlogo))</visible>
			</control>
			<!-- Clearlogo (when available) -->
			<control type="image">
				<top>55</top>
				<width max="450">auto</width>
				<height>130</height>
				<aspectratio aligny="bottom">keep</aspectratio>
				<texture background="true">$INFO[Window.Property(tikiskins.detail.clearlogo)]</texture>
				<visible>!String.IsEmpty(Window.Property(tikiskins.detail.clearlogo))</visible>
			</control>
			<!-- Tagline -->
			<control type="label">
				<top>195</top>
				<width>840</width>
				<height>22</height>
				<font>font12</font>
				<textcolor>FF888888</textcolor>
				<label>[I]$INFO[Window.Property(tikiskins.detail.tagline)][/I]</label>
				<visible>!String.IsEmpty(Window.Property(tikiskins.detail.tagline))</visible>
			</control>
			<!-- Year and Runtime -->
			<control type="label">
				<top>225</top>
				<width>840</width>
				<height>22</height>
				<font>font12</font>
				<textcolor>FFAAAAAA</textcolor>
				<label>$INFO[Window.Property(tikiskins.detail.year_runtime)]</label>
			</control>
			<!-- Ratings Row -->
			<control type="grouplist">
				<top>258</top>
				<width max="840">auto</width>
				<height>40</height>
				<itemgap>6</itemgap>
				<orientation>horizontal</orientation>
				<!-- IMDb -->
				<control type="image">
					<height>30</height>
					<width>45</width>
					<aspectratio>keep</aspectratio>
					<texture>imdb_small.png</texture>
					<visible>!String.IsEmpty(Window.Property(tikiskins.detail.rating.imdb))</visible>
				</control>
				<control type="label">
					<height>40</height>
					<width>50</width>
					<font>font12</font>
					<textcolor>FFF5C518</textcolor>
					<align>left</align>
					<aligny>center</aligny>
					<label>[B]$INFO[Window.Property(tikiskins.detail.rating.imdb)][/B]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.detail.rating.imdb))</visible>
				</control>
				<!-- Metacritic -->
				<control type="image">
					<height>28</height>
					<width>35</width>
					<aspectratio>keep</aspectratio>
					<texture>metacritic.png</texture>
					<visible>!String.IsEmpty(Window.Property(tikiskins.detail.rating.metacritic))</visible>
				</control>
				<control type="label">
					<height>40</height>
					<width>40</width>
					<font>font12</font>
					<textcolor>FF66CCFF</textcolor>
					<align>left</align>
					<aligny>center</aligny>
					<label>[B]$INFO[Window.Property(tikiskins.detail.rating.metacritic)][/B]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.detail.rating.metacritic))</visible>
				</control>
				<!-- Rotten Tomatoes -->
				<control type="image">
					<height>28</height>
					<width>35</width>
					<aspectratio>keep</aspectratio>
					<texture>tomatoes.png</texture>
					<visible>!String.IsEmpty(Window.Property(tikiskins.detail.rating.tomatoes))</visible>
				</control>
				<control type="label">
					<height>40</height>
					<width>50</width>
					<font>font12</font>
					<textcolor>FFFF6347</textcolor>
					<align>left</align>
					<aligny>center</aligny>
					<label>[B]$INFO[Window.Property(tikiskins.detail.rating.tomatoes)]%[/B]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.detail.rating.tomatoes))</visible>
				</control>
				<!-- Trakt -->
				<control type="image">
					<height>28</height>
					<width>35</width>
					<aspectratio>keep</aspectratio>
					<texture>trakt.png</texture>
					<visible>!String.IsEmpty(Window.Property(tikiskins.detail.rating.trakt))</visible>
				</control>
				<control type="label">
					<height>40</height>
					<width>50</width>
					<font>font12</font>
					<textcolor>FFED1C24</textcolor>
					<align>left</align>
					<aligny>center</aligny>
					<label>[B]$INFO[Window.Property(tikiskins.detail.rating.trakt)][/B]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.detail.rating.trakt))</visible>
				</control>
				<!-- TMDB -->
				<control type="image">
					<height>28</height>
					<width>35</width>
					<aspectratio>keep</aspectratio>
					<texture>tmdb_small.png</texture>
					<visible>!String.IsEmpty(Window.Property(tikiskins.detail.rating.tmdb))</visible>
				</control>
				<control type="label">
					<height>40</height>
					<width>50</width>
					<font>font12</font>
					<textcolor>FF01D277</textcolor>
					<align>left</align>
					<aligny>center</aligny>
					<label>[B]$INFO[Window.Property(tikiskins.detail.rating.tmdb)][/B]</label>
					<visible>!String.IsEmpty(Window.Property(tikiskins.detail.rating.tmdb))</visible>
				</control>
			</control>
			<!-- Genre -->
			<control type="label">
				<top>305</top>
				<width>840</width>
				<height>22</height>
				<font>font12</font>
				<textcolor>FFCCCCCC</textcolor>
				<label>$INFO[Window.Property(tikiskins.detail.genre)]</label>
			</control>
			<!-- SUMMARY Header -->
			<control type="label">
				<top>345</top>
				<width>200</width>
				<height>22</height>
				<font>font12</font>
				<textcolor>FF00BFA5</textcolor>
				<label>[B]SUMMARY[/B]</label>
			</control>
			<!-- Plot -->
			<control type="textbox">
				<top>375</top>
				<width>840</width>
				<height>130</height>
				<font>font12</font>
				<textcolor>FF999999</textcolor>
				<label>$INFO[Window.Property(tikiskins.detail.plot)]</label>
				<autoscroll delay="6000" time="2000" repeat="8000">true</autoscroll>
			</control>
			<!-- CAST & CREW Header -->
			<control type="label">
				<top>520</top>
				<width>200</width>
				<height>22</height>
				<font>font12</font>
				<textcolor>FF00BFA5</textcolor>
				<label>[B]CAST &amp; CREW[/B]</label>
			</control>
			<!-- Cast Panel (horizontal scroll of cast images) -->
			<control type="panel" id="5010">
				<top>550</top>
				<width>840</width>
				<height>170</height>
				<onup>5001</onup>
				<ondown>5001</ondown>
				<onright>5020</onright>
				<scrolltime>250</scrolltime>
				<orientation>horizontal</orientation>
				<itemlayout height="170" width="110">
					<control type="group">
						<left>5</left>
						<!-- Cast avatar (square) -->
						<control type="image">
							<width>95</width>
							<height>95</height>
							<aspectratio>scale</aspectratio>
							<texture background="true">$INFO[ListItem.Property(tikiskins.detail.cast.thumb)]</texture>
						</control>
						<!-- Cast name -->
						<control type="label">
							<top>100</top>
							<width>95</width>
							<height>18</height>
							<font>font10</font>
							<textcolor>FFFFFFFF</textcolor>
							<align>center</align>
							<label>$INFO[ListItem.Property(tikiskins.detail.cast.name)]</label>
						</control>
						<!-- Cast role -->
						<control type="label">
							<top>120</top>
							<width>95</width>
							<height>16</height>
							<font>font10</font>
							<textcolor>FF666666</textcolor>
							<align>center</align>
							<label>$INFO[ListItem.Property(tikiskins.detail.cast.role)]</label>
						</control>
					</control>
				</itemlayout>
				<focusedlayout height="170" width="110">
					<control type="group">
						<left>5</left>
						<animation effect="zoom" start="100" end="108" time="100" tween="sine" center="52,85">Focus</animation>
						<control type="image">
							<width>95</width>
							<height>95</height>
							<aspectratio>scale</aspectratio>
							<texture background="true">$INFO[ListItem.Property(tikiskins.detail.cast.thumb)]</texture>
						</control>
						<!-- Focus ring -->
						<control type="image">
							<left>-3</left>
							<top>-3</top>
							<width>101</width>
							<height>101</height>
							<texture colordiffuse="FF00BFA5" border="3">white.png</texture>
						</control>
						<control type="label">
							<top>100</top>
							<width>95</width>
							<height>18</height>
							<font>font10</font>
							<textcolor>FFFFFFFF</textcolor>
							<align>center</align>
							<label>$INFO[ListItem.Property(tikiskins.detail.cast.name)]</label>
						</control>
						<control type="label">
							<top>120</top>
							<width>95</width>
							<height>16</height>
							<font>font10</font>
							<textcolor>FF00BFA5</textcolor>
							<align>center</align>
							<label>$INFO[ListItem.Property(tikiskins.detail.cast.role)]</label>
						</control>
					</control>
				</focusedlayout>
			</control>
		</control>
		<!-- Bottom Toolbar -->
		<control type="group">
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="500" delay="300" />
				<effect type="slide" start="0,30" end="0" time="300" delay="300" tween="quadratic" easing="out" />
			</animation>
			<left>60</left>
			<top>740</top>
			<!-- Divider line -->
			<control type="image">
				<width>840</width>
				<height>1</height>
				<texture colordiffuse="FF333333">white.png</texture>
			</control>
			<!-- Action Buttons -->
			<control type="grouplist">
				<top>15</top>
				<width>840</width>
				<height>55</height>
				<itemgap>12</itemgap>
				<orientation>horizontal</orientation>
				<!-- Watch Now / Play -->
				<control type="button" id="5001">
					<width>200</width>
					<height>50</height>
					<font>font14</font>
					<textcolor>FFFFFFFF</textcolor>
					<focusedcolor>FFFFFFFF</focusedcolor>
					<align>center</align>
					<aligny>center</aligny>
					<label>[B]Watch Now[/B]</label>
					<texturefocus colordiffuse="FF00BFA5">white.png</texturefocus>
					<texturenofocus colordiffuse="FF008C7A">white.png</texturenofocus>
					<onup>5010</onup>
					<ondown>5000</ondown>
					<onright>5002</onright>
				</control>
				<!-- Trailer -->
				<control type="button" id="5002">
					<width>130</width>
					<height>50</height>
					<font>font12</font>
					<textcolor>FFCCCCCC</textcolor>
					<focusedcolor>FFFFFFFF</focusedcolor>
					<align>center</align>
					<aligny>center</aligny>
					<label>Trailer</label>
					<texturefocus colordiffuse="FF333340">white.png</texturefocus>
					<texturenofocus colordiffuse="FF1A1A24">white.png</texturenofocus>
					<onup>5010</onup>
					<ondown>5000</ondown>
					<onleft>5001</onleft>
					<onright>5003</onright>
				</control>
				<!-- Add to Library -->
				<control type="button" id="5003">
					<width>170</width>
					<height>50</height>
					<font>font12</font>
					<textcolor>FFCCCCCC</textcolor>
					<focusedcolor>FFFFFFFF</focusedcolor>
					<align>center</align>
					<aligny>center</aligny>
					<label>Add to Library</label>
					<texturefocus colordiffuse="FF333340">white.png</texturefocus>
					<texturenofocus colordiffuse="FF1A1A24">white.png</texturenofocus>
					<onup>5010</onup>
					<ondown>5000</ondown>
					<onleft>5002</onleft>
					<onright>5004</onright>
				</control>
				<!-- Extras (opens full extras window) -->
				<control type="button" id="5004">
					<width>120</width>
					<height>50</height>
					<font>font12</font>
					<textcolor>FFCCCCCC</textcolor>
					<focusedcolor>FFFFFFFF</focusedcolor>
					<align>center</align>
					<aligny>center</aligny>
					<label>Extras</label>
					<texturefocus colordiffuse="FF333340">white.png</texturefocus>
					<texturenofocus colordiffuse="FF1A1A24">white.png</texturenofocus>
					<onup>5010</onup>
					<ondown>5000</ondown>
					<onleft>5003</onleft>
				</control>
			</control>
		</control>
		<!-- RIGHT PANEL: Source Results (for movies) -->
		<control type="group">
			<visible>String.IsEqual(Window.Property(tikiskins.detail.media_type),movie)</visible>
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="500" delay="200" />
				<effect type="slide" start="30,0" end="0" time="400" delay="200" tween="quadratic" easing="out" />
			</animation>
			<left>980</left>
			<top>40</top>
			<!-- Panel Header -->
			<control type="label">
				<width>400</width>
				<height>30</height>
				<font>font14</font>
				<textcolor>FFFFFFFF</textcolor>
				<label>[B]Sources[/B]  $INFO[Window.Property(tikiskins.detail.sources.count)]</label>
			</control>
			<!-- Sources list -->
			<control type="fixedlist" id="5020">
				<top>45</top>
				<width>880</width>
				<height>720</height>
				<onleft>5001</onleft>
				<scrolltime>250</scrolltime>
				<orientation>vertical</orientation>
				<focusposition>3</focusposition>
				<movement>4</movement>
				<itemlayout height="80" width="880">
					<control type="image">
						<top>4</top>
						<width>880</width>
						<height>72</height>
						<texture colordiffuse="BF151520">white.png</texture>
					</control>
					<!-- Quality badge -->
					<control type="group">
						<top>15</top>
						<left>15</left>
						<width>55</width>
						<height>45</height>
						<control type="image">
							<width>55</width>
							<height>45</height>
							<texture colordiffuse="$INFO[ListItem.Property(tikiskins.detail.source.quality_color)]">white.png</texture>
						</control>
						<control type="label">
							<width>55</width>
							<height>22</height>
							<top>3</top>
							<font>font10</font>
							<textcolor>FFFFFFFF</textcolor>
							<align>center</align>
							<label>[B]$INFO[ListItem.Property(tikiskins.detail.source.quality)][/B]</label>
						</control>
						<control type="label">
							<width>55</width>
							<height>18</height>
							<top>22</top>
							<font>font10</font>
							<textcolor>FFDDDDDD</textcolor>
							<align>center</align>
							<label>$INFO[ListItem.Property(tikiskins.detail.source.provider)]</label>
						</control>
					</control>
					<!-- Source details -->
					<control type="label">
						<left>85</left>
						<top>12</top>
						<width>700</width>
						<height>20</height>
						<font>font12</font>
						<textcolor>FF999999</textcolor>
						<align>left</align>
						<label>$INFO[ListItem.Property(tikiskins.detail.source.name)]</label>
					</control>
					<control type="label">
						<left>85</left>
						<top>38</top>
						<width>700</width>
						<height>20</height>
						<font>font10</font>
						<textcolor>FF666666</textcolor>
						<align>left</align>
						<label>$INFO[ListItem.Property(tikiskins.detail.source.extra_info)]  |  $INFO[ListItem.Property(tikiskins.detail.source.size)]  |  $INFO[ListItem.Property(tikiskins.detail.source.source_type)]</label>
					</control>
				</itemlayout>
				<focusedlayout height="80" width="880">
					<control type="group">
						<animation effect="zoom" start="100" end="101" time="80" tween="sine" center="440,40">Focus</animation>
						<control type="image">
							<top>4</top>
							<width>880</width>
							<height>72</height>
							<texture colordiffuse="FF252530">white.png</texture>
						</control>
						<!-- Accent border on left -->
						<control type="image">
							<top>4</top>
							<width>3</width>
							<height>72</height>
							<texture colordiffuse="FF00BFA5">white.png</texture>
						</control>
						<!-- Quality badge -->
						<control type="group">
							<top>15</top>
							<left>15</left>
							<width>55</width>
							<height>45</height>
							<control type="image">
								<width>55</width>
								<height>45</height>
								<texture colordiffuse="$INFO[ListItem.Property(tikiskins.detail.source.quality_color)]">white.png</texture>
							</control>
							<control type="label">
								<width>55</width>
								<height>22</height>
								<top>3</top>
								<font>font10</font>
								<textcolor>FFFFFFFF</textcolor>
								<align>center</align>
								<label>[B]$INFO[ListItem.Property(tikiskins.detail.source.quality)][/B]</label>
							</control>
							<control type="label">
								<width>55</width>
								<height>18</height>
								<top>22</top>
								<font>font10</font>
								<textcolor>FFDDDDDD</textcolor>
								<align>center</align>
								<label>$INFO[ListItem.Property(tikiskins.detail.source.provider)]</label>
							</control>
						</control>
						<!-- Source details -->
						<control type="label">
							<left>85</left>
							<top>12</top>
							<width>700</width>
							<height>20</height>
							<font>font12</font>
							<textcolor>FFFFFFFF</textcolor>
							<align>left</align>
							<label>$INFO[ListItem.Property(tikiskins.detail.source.name)]</label>
						</control>
						<control type="label">
							<left>85</left>
							<top>38</top>
							<width>700</width>
							<height>20</height>
							<font>font10</font>
							<textcolor>FFAAAAAA</textcolor>
							<align>left</align>
							<label>$INFO[ListItem.Property(tikiskins.detail.source.extra_info)]  |  $INFO[ListItem.Property(tikiskins.detail.source.size)]  |  $INFO[ListItem.Property(tikiskins.detail.source.source_type)]</label>
						</control>
					</control>
				</focusedlayout>
			</control>
			<!-- Scrollbar -->
			<control type="scrollbar" id="5021">
				<top>45</top>
				<left>870</left>
				<width>8</width>
				<height>720</height>
				<texturesliderbackground colordiffuse="FF151520">white.png</texturesliderbackground>
				<texturesliderbar colordiffuse="FF333340">white.png</texturesliderbar>
				<texturesliderbarfocus colordiffuse="FF00BFA5">white.png</texturesliderbarfocus>
				<showonepage>false</showonepage>
				<orientation>vertical</orientation>
			</control>
			<!-- Loading indicator -->
			<control type="image">
				<centerleft>440</centerleft>
				<centertop>400</centertop>
				<width>50</width>
				<height>50</height>
				<texture>loading-spinner.png</texture>
				<visible>String.IsEqual(Window.Property(tikiskins.detail.sources.loading),true)</visible>
				<animation effect="rotate" start="0" end="360" time="1500" loop="true" center="auto">Visible</animation>
			</control>
		</control>
		<!-- RIGHT PANEL: Episodes (for TV shows) -->
		<control type="group">
			<visible>String.IsEqual(Window.Property(tikiskins.detail.media_type),tvshow)</visible>
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="500" delay="200" />
				<effect type="slide" start="30,0" end="0" time="400" delay="200" tween="quadratic" easing="out" />
			</animation>
			<left>980</left>
			<top>40</top>
			<!-- Season Selector -->
			<control type="grouplist">
				<width>880</width>
